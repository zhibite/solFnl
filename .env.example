# debot login session (beegosessionID cookie value)
# Reserved for later: the debot source is currently disabled (GMGN only).
DEBOT_SESSION_ID=

# web console login password (username: zengsw)
# Required in production; leave empty only for local dev (a random password
# is printed to the log on startup).
GMGN_PASSWORD=

# session signing key (stable across restarts / workers): openssl rand -hex 32
SESSION_SECRET=

# server
HOST=0.0.0.0
PORT=8038

# sqlite
DATABASE_PATH=/data/gmgndaily.db

# sync: current month after SYNC_INTERVAL_MIN, older months after
# HISTORY_SYNC_INTERVAL_MIN; each tick processes at most SYNC_BATCH_SIZE
# wallets and SYNC_MAX_REQUESTS_PER_TICK GMGN requests.
SYNC_INTERVAL_MIN=60
HISTORY_SYNC_INTERVAL_MIN=1440

# wallet metadata queue (follow/remark/7d): batch/tick + on-demand cache
META_SYNC_INTERVAL_MIN=60
META_TICK_SECONDS=30
META_BATCH_SIZE=20
META_LIVE_CACHE_SECONDS=60
META_LIVE_TIMEOUT_SECONDS=10
META_LIVE_MAX_REQUESTS_PER_MINUTE=60
SCORE_WINDOW_DAYS=90
SYNC_MONTHS_BACK=2
SYNC_TICK_SECONDS=60
SYNC_BATCH_SIZE=60
SYNC_MAX_REQUESTS_PER_TICK=60
SYNC_LOG_RETENTION_DAYS=7

# max concurrent /api/track syncs
TRACK_MAX_CONCURRENT=4
MAX_BATCH_WALLETS=500
MAX_BATCH_PROFIT_ADDRESSES=30

# chain for the data source (GMGN requires "sol"; "solana" is normalized)
CHAIN=solana
