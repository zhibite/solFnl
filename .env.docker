# Debot login session (beegosessionID cookie value)
# Reserved for later: the debot source is currently disabled (GMGN only).
DEBOT_SESSION_ID=

# Web console login password (username: zengsw)
# REQUIRED: docker compose refuses to start while this is empty.
# Generate one with: openssl rand -base64 18
GMGN_PASSWORD=

# Starlette session signing key.
# REQUIRED for stable logins across restarts / multiple workers.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Server configuration (Coolify will handle reverse proxy and domain binding)
HOST=0.0.0.0
PORT=8038

# SQLite database path (persisted in docker volume)
DATABASE_PATH=/data/gmgndaily.db

# Sync configuration:
# - current month is re-checked after SYNC_INTERVAL_MIN minutes
# - older months are re-checked after HISTORY_SYNC_INTERVAL_MIN minutes (24h)
# - every SYNC_TICK_SECONDS the queue processes up to SYNC_BATCH_SIZE wallets,
#   but never more than SYNC_MAX_REQUESTS_PER_TICK GMGN requests
# - public wallet metadata (follow/remark/7d stats) uses its own queue:
#   every META_TICK_SECONDS it refreshes META_BATCH_SIZE wallets older than
#   META_SYNC_INTERVAL_MIN; single-wallet requests refresh on demand with a
#   META_LIVE_CACHE_SECONDS cache.
# - GMGN buckets daily rows by the calendar day of GMGN_TZ_NAME; the console's
#   "today" column follows the same timezone.
SYNC_INTERVAL_MIN=60
HISTORY_SYNC_INTERVAL_MIN=1440
META_SYNC_INTERVAL_MIN=60
META_TICK_SECONDS=30
META_BATCH_SIZE=40
META_LIVE_CACHE_SECONDS=60
META_LIVE_TIMEOUT_SECONDS=10
META_LIVE_MAX_REQUESTS_PER_MINUTE=60
SCORE_WINDOW_DAYS=90
SYNC_MONTHS_BACK=2
SYNC_TICK_SECONDS=60
SYNC_BATCH_SIZE=180
SYNC_MAX_REQUESTS_PER_TICK=180
SYNC_LOG_RETENTION_DAYS=7
GMGN_TZ_NAME=Asia/Shanghai
GMGN_TZ_OFFSET=28800

# Max concurrent /api/track syncs (protects the server from public callers)
TRACK_MAX_CONCURRENT=4
MAX_BATCH_WALLETS=500
MAX_BATCH_PROFIT_ADDRESSES=30

# Chain for the data source (GMGN requires "sol"; "solana" is normalized)
CHAIN=sol
