# Debot login session (beegosessionID cookie value)
# Reserved for later: the debot source is currently disabled (GMGN only).
DEBOT_SESSION_ID=

# Web console login password (username: zengsw)
# REQUIRED: docker compose refuses to start while this is empty.
# Generate one with: openssl rand -base64 18
GMGN_PASSWORD=

# Starlette session signing key.
# REQUIRED for stable logins across restarts / multiple workers.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Server configuration (Coolify will handle reverse proxy and domain binding)
HOST=0.0.0.0
PORT=8038

# SQLite database path (persisted in docker volume)
DATABASE_PATH=/data/gmgndaily.db

# Sync configuration: a wallet is re-synced when its last attempt is older
# than SYNC_INTERVAL_MIN minutes. The scheduler drains this queue in batches
# of SYNC_BATCH_SIZE every SYNC_TICK_SECONDS seconds.
SYNC_INTERVAL_MIN=60
SYNC_MONTHS_BACK=2
SYNC_TICK_SECONDS=60
SYNC_BATCH_SIZE=20
SYNC_LOG_RETENTION_DAYS=7

# Max concurrent /api/track syncs (protects the server from public callers)
TRACK_MAX_CONCURRENT=4

# Chain for the data source (GMGN requires "sol"; "solana" is normalized)
CHAIN=sol
